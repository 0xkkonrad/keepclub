__pycache__/
*.pyc

# Card-authoring output. Generated by content/*/src/*build.py; what ships is
# the copy under web/courses/, which is committed. Both courses rebuild from
# this repo alone since Day Skipper's source moved in on 28 July 2026 — the one
# exception is re-encoding a video clip, which needs the 156 MB of downloaded
# originals that have never lived in a repo. The encoded clips are committed
# under content/day-skipper/video/clips/ precisely so that is never needed.
content/*/build/

# Test fixtures are generated .apkg files, some of them large.
tests/fixtures/
